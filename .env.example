# Study Mate Backend Environment Variables
# Copy to .env for local development or configure in Cloud Run runtime environment variables.
# Do not commit real secret values to version control.

# Google Cloud Platform (Required for Gemini and Speech-to-Text)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global

# Gemini Model Selection (Optional)
GEMINI_MODEL=gemini-2.5-flash

# STT Session Configuration (Optional, milliseconds)
STT_MAX_SESSION_MS=270000

# Public Data Integration (Optional)
YOUTH_POLICY_API_KEY=your-ontong-youth-api-key

# Server & Network Configuration (Cloud Run sets PORT automatically)
PORT=8080
HOST=0.0.0.0

# CORS & WebSocket Allowed Origins (Comma-separated)
# In production, specify your frontend domains (e.g. https://your-site.genspark.app)
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000
